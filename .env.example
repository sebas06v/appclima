# Copia este archivo como .env y rellena los valores.
#   cp .env.example .env
# .env está en .gitignore: nunca se sube al repositorio.

# ---------- Open-Meteo ----------
# API key de Open-Meteo. Opcional: el plan gratuito NO requiere key.
# Si la defines, el servidor usa los endpoints comerciales de Open-Meteo
# (customer-api.open-meteo.com) y añade el parámetro apikey a cada petición.
OPEN_METEO_API_KEY=

# ---------- Correo (Resend) ----------
# API key del proveedor de correo. Se obtiene en https://resend.com/api-keys
# Sin ella, los correos se imprimen en el log del servidor en vez de enviarse.
RESEND_API_KEY=

# Remitente del correo de bienvenida.
# onboarding@resend.dev funciona sin verificar dominio, pero solo permite enviar
# a la dirección con la que te registraste en Resend. Para enviar a cualquier
# destinatario hay que verificar un dominio propio.
MAIL_FROM=AppClima <onboarding@resend.dev>

# URL con la que se construyen los enlaces del correo.
APP_URL=http://localhost:3000

# Tiempo máximo de espera del proveedor de correo (milisegundos).
MAIL_TIMEOUT_MS=10000

# ---------- Acceso con Google (OAuth 2.0) ----------
# Credenciales de un "ID de cliente de OAuth" de tipo "Aplicación web", creado en
# https://console.cloud.google.com/apis/credentials
# Si faltan, el botón "Continuar con Google" no se muestra y la app funciona igual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con el "URI de redireccionamiento autorizado"
# registrado en Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---------- Sesiones ----------
# Clave para firmar las cookies de sesión. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no se define, se genera una temporal y las sesiones caducan al reiniciar.
SESSION_SECRET=

# Marca las cookies como Secure. Ponlo en true solo si sirves la app por HTTPS.
COOKIE_SECURE=false

# ---------- Servidor ----------
PORT=3000
OPEN_METEO_TIMEOUT_MS=10000
CACHE_TTL_MS=600000
